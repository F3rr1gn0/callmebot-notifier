{
  "name": "callmebot-notifier",
  "version": "1.11.0",
  "description": "Typed notification library for Node.js with WhatsApp, Telegram, Signal, Email, Discord, Slack, Google Chat, and Microsoft Teams.",
  "license": "MIT",
  "author": "F3rr1gn0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "callmebot-notifier": "./dist/cli.js",
    "cmb-notify": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/F3rr1gn0/callmebot-notifier.git"
  },
  "bugs": {
    "url": "https://github.com/F3rr1gn0/callmebot-notifier/issues"
  },
  "homepage": "https://github.com/F3rr1gn0/callmebot-notifier#readme",
  "keywords": [
    "callmebot",
    "whatsapp",
    "notification",
    "telegram",
    "email",
    "discord",
    "slack",
    "google chat",
    "googlechat",
    "teams",
    "signal",
    "signal-cli-rest-api",
    "express",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./whatsapp": {
      "types": "./dist/whatsapp.d.ts",
      "import": "./dist/whatsapp.js",
      "require": "./dist/whatsapp.cjs"
    },
    "./telegram": {
      "types": "./dist/telegram.d.ts",
      "import": "./dist/telegram.js",
      "require": "./dist/telegram.cjs"
    },
    "./email": {
      "types": "./dist/email.d.ts",
      "import": "./dist/email.js",
      "require": "./dist/email.cjs"
    },
    "./webpush": {
      "types": "./dist/webpush.d.ts",
      "import": "./dist/webpush.js",
      "require": "./dist/webpush.cjs"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js",
      "require": "./dist/express.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx examples/express/server.ts",
    "pretest": "npm run build",
    "test": "vitest run",
    "pretest:coverage": "npm run build",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.22.2",
    "nodemailer": "^9.0.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "cookie": "^0.7.2",
    "esbuild": "^0.28.1",
    "qs": "^6.15.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.29",
    "@types/nodemailer": "^6.4.17",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^3.2.4",
    "tsup": "^8.5.0",
    "tsx": "^4.22.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
